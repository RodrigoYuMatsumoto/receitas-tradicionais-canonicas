            "$ref": "#/$defs/Request"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/SourceEvidence"
            },
            "maxItems": 100,
            "title": "Sources",
            "type": "array"
          },
          "queries": {
            "items": {
              "$ref": "#/$defs/Query"
            },
            "maxItems": 100,
            "title": "Queries",
            "type": "array"
          },
          "completed_tracks": {
            "items": {
              "enum": [
                "base",
                "domestic_regional"
              ],
              "type": "string"
            },
            "maxItems": 10,
            "title": "Completed Tracks",
            "type": "array"
          },
          "pages_read": {
            "maximum": 1000,
            "minimum": 0,
            "title": "Pages Read",
            "type": "integer"
          },
          "researchers_count": {
            "maximum": 3,
            "minimum": 1,
            "title": "Researchers Count",
            "type": "integer"
          },
          "reformulations_by_track": {
            "$ref": "#/$defs/ReformulationsByTrack"
          },
          "reviewer_notes": {
            "items": {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 200,
            "title": "Reviewer Notes",
            "type": "array"
          }
        },
        "required": [
          "request",
          "sources",
          "queries",
          "completed_tracks",
          "pages_read",
          "researchers_count",
          "reformulations_by_track"
        ],
        "title": "ResearchBatch",
        "type": "object"
      },
      "SourceEvidence": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "url": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "author": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Author",
            "type": "string"
          },
          "publisher": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Publisher",
            "type": "string"
          },
          "editorial_group": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Editorial Group",
            "type": "string"
          },
          "country": {
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "type": "string"
          },
          "editorial_country_evidence": {
            "$ref": "#/$defs/EditorialCountryEvidence"
          },
          "accessed_at": {
            "format": "date",
            "title": "Accessed At",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publication Date"
          },
          "read_status": {
            "enum": [
              "complete",
              "snippet",
              "unavailable"
            ],
            "title": "Read Status",
            "type": "string"
          },
          "kind": {
            "enum": [
              "domestic",
              "editorial",
              "institutional"
            ],
            "title": "Kind",
            "type": "string"
          },
          "research_track": {
            "enum": [
              "base",
              "domestic_regional"
            ],
            "title": "Research Track",
            "type": "string"
          },
          "sections": {
            "$ref": "#/$defs/SourceSections"
          },
          "ingredients": {
            "items": {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 200,
            "title": "Ingredients",
            "type": "array"
          },
          "technique_summary": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Technique Summary",
            "type": "string"
          },
          "detail_notes": {
            "items": {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 200,
            "title": "Detail Notes",
            "type": "array"
          },
          "provenance_origin": {
            "description": "URL HTTP(S) da publicação original da receita, usada para identificar republicações; não informe descrição em prosa.",
            "format": "uri",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Provenance Origin",
            "type": "string"
          },
          "provenance_verification": {
            "default": "pending",
            "description": "Qualificação declarada da origem e da independência editorial; exige revisão semântica das evidências.",
            "enum": [
              "confirmed",
              "pending"
            ],
            "title": "Provenance Verification",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "author",
          "publisher",
          "editorial_group",
          "country",
          "editorial_country_evidence",
          "accessed_at",
          "read_status",
          "kind",
          "research_track",
          "sections",
          "ingredients",
          "technique_summary",
          "provenance_origin"
        ],
        "title": "SourceEvidence",
        "type": "object"
      },
      "SourceSections": {
        "additionalProperties": false,
        "properties": {
          "ingredients": {
            "enum": [
              "read",
              "absent",
              "unavailable"
            ],
            "title": "Ingredients",
            "type": "string"
          },
          "method": {
            "enum": [
              "read",
              "absent",
              "unavailable"
            ],
            "title": "Method",
            "type": "string"
          },
          "notes": {
            "enum": [
              "read",
              "absent",
              "unavailable"
            ],
            "title": "Notes",
            "type": "string"
          },
          "comments": {
            "enum": [
              "read",
              "absent",
              "unavailable"
            ],
            "title": "Comments",
            "type": "string"
          }
        },
        "required": [
          "ingredients",
          "method",
          "notes",
          "comments"
        ],
        "title": "SourceSections",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Lote e perfil únicos; o pedido operacional deriva exclusivamente do lote.",
    "properties": {
      "research": {
        "$ref": "#/$defs/ResearchBatch"
      },
      "ingredients": {
        "items": {
          "$ref": "#/$defs/IngredientItem"
        },
        "maxItems": 200,
        "title": "Ingredients",
        "type": "array"
      },
      "steps": {
        "items": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 200,
        "title": "Steps",
        "type": "array"
      },
      "labels_reviewed": {
        "title": "Labels Reviewed",
        "type": "boolean"
      },
      "cross_contact_reviewed": {
        "default": false,
        "title": "Cross Contact Reviewed",
        "type": "boolean"
      },
      "adaptation_notes": {
        "items": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 200,
        "title": "Adaptation Notes",
        "type": "array"
      }
    },
    "required": [
      "research",
      "ingredients",
      "steps",
      "labels_reviewed"
    ],
    "title": "Delivery",
    "type": "object"
  }
}
